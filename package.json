{
  "name": "jira-description-to-github-pr",
  "version": "1.3.0",
  "author": "Eirik Skjeggestad Dale",
  "description": "Copy Jira descriptions to a Pull Request description",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@octokit/rest": "^22.0.1",
    "extended-markdown-adf-parser": "^2.4.0",
    "jira2md": "^3.0.1",
    "markdown-to-txt": "^2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^25.2.3",
    "@types/node": "^20.11.17",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.56.0",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jsonc": "^2.13.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "make-coverage-badge": "^1.2.0",
    "nock": "^14.0.12",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "keywords": [
    "jira",
    "github",
    "description"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3lvia/jira-description-to-github-pr.git"
  },
  "scripts": {
    "all": "npm run format:write && npm run lint && npm run package",
    "bundle": "npm run format:write && npm run package",
    "test": "jest",
    "test:watch": "jest --watch",
    "format:check": "prettier --check **/*.ts",
    "format:write": "prettier --write **/*.ts",
    "lint": "npx eslint . -c ./.github/linters/.eslintrc.yml",
    "package": "ncc build src/index.ts --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "preinstall": "cp scripts/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit && echo 'hook copied'"
  }
}
